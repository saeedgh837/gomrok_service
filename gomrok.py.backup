def _mark_panel_profile_unusable(profile_id, error_text):
    try:
        import panel
        return panel.mark_profile_unusable(profile_id, error_text)
    except Exception as e:
        print(f">>> (mark-e profile-e gheyr-e ghabele voroud anjam nashod: {e})")
        return False


def _start_profile_heartbeat(profile_id, runner_id):
    import threading

    def beat():
        while True:
            try:
                import panel
                if not panel.heartbeat_profile(profile_id, runner_id):
                    return
            except Exception:
                pass
            time.sleep(30)

    thread = threading.Thread(target=beat, name="profile-heartbeat", daemon=True)
    thread.start()
    return thread


_LOGS_PATH = os.path.join(_HERE, "logs.jsonl")
_SCREENSHOTS_DIR = os.path.join(_HERE, "screenshots")
