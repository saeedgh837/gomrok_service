def log_event(status, message, step="", title="", national="", imei=""):
    """Yek rvidaad-e MOHEM (faghat khata/natije) ra ham dar console va ham dar
    logs.jsonl (yek JSON dar har khat) zakhire mikonad. Panel-e tahte-web in
    file ra mikhanad va namayesh midahad (ba serial/IMEI ta bedanim baraye ki bud).

    status: 'error' | 'success' | 'warn' | 'info'
    """
    import json
    rec = {
        "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
        "title": title or "",
        "national": national or "",
        "imei": imei or "",
        "step": step or "",
        "status": status,
        "message": message or "",
    }
    tag = {"error": "❌", "success": "✅", "warn": "⚠️", "info": "ℹ️"}.get(status, "•")
    try:
        # farsi ra be console-e cp1252 nafrest -> ascii-safe
        safe = message.encode("unicode_escape").decode("ascii")
    except Exception:
        safe = str(message)
    print(f">>> [LOG {tag} {status}] {step} | serial={imei} | {safe}")
    try:
        with open(_LOGS_PATH, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except Exception as e:
        print(f">>> (zakhire-ye log na-shod: {e})")


def install_profile_banner(driver, title):
    """Nam-e profile ra dar hame-ye page-haye in browser sabet neshan midahad."""
    import json
    label = json.dumps(str(title or "profile"), ensure_ascii=False)
    source = """
(() => {
  const id = 'hermes-profile-banner';
  const show = () => {
    if (!document.documentElement || window.__hermes_profile_banner_closed || document.getElementById(id)) return;
    const el = document.createElement('div');
    el.id = id;
    el.setAttribute('data-hermes-hide-in-screenshot', '1');
    el.innerHTML = '<span>PROFILE: ' + %s + '</span><button id="hermes-profile-banner-close" aria-label="بستن">×</button>';
    el.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:2147483646;background:#1677ff;color:#fff;border:2px solid #fff;border-radius:0 0 10px 10px;padding:8px 12px 8px 18px;font:700 16px Tahoma,Arial,sans-serif;box-shadow:0 4px 14px rgba(0,0,0,.35);direction:rtl;display:flex;align-items:center;justify-content:center;gap:14px;pointer-events:auto;white-space:nowrap';
    const close = el.querySelector('#hermes-profile-banner-close');
    close.style.cssText = 'border:0;background:#095dcc;color:#fff;border-radius:50%%;width:24px;height:24px;font:700 20px Arial;line-height:20px;cursor:pointer;padding:0';
    close.onclick = () => { window.__hermes_profile_banner_closed = true; el.remove(); };
    (document.body || document.documentElement).appendChild(el);
  };
  const watch = () => {
    show();
    if(document.documentElement && !window.__hermes_profile_banner_observer){
      window.__hermes_profile_banner_observer = new MutationObserver(show);
      window.__hermes_profile_banner_observer.observe(document.documentElement, {childList:true, subtree:true});
    }
  };
  watch();
  setInterval(watch, 250);
  window.__hermes_profile_banner_help = 'until closed';
})();
""" % label
    driver.execute_cdp_cmd("Page.addScriptToEvaluateOnNewDocument", {"source": source})
    driver.execute_script(source)

