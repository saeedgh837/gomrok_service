def ensure_utf8_stdio():
    """Windows worker log is UTF-8; force stdout/stderr off cp1252 crash."""
    os.environ.setdefault("PYTHONIOENCODING", "utf-8")
    os.environ.setdefault("PYTHONUTF8", "1")
    for stream_name in ("stdout", "stderr"):
        stream = getattr(sys, stream_name, None)
        if stream is None:
            continue
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
            continue
        except Exception:
            pass
        try:
            import io
            buf = getattr(stream, "buffer", None)
            if buf is not None:
                setattr(sys, stream_name, io.TextIOWrapper(buf, encoding="utf-8", errors="replace", line_buffering=True))
        except Exception:
            pass


ensure_utf8_stdio()

