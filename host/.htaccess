# Protect internal package folders while routing web traffic to public/
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Spec §10.8 — deny direct access to internal folders and hidden files
    RewriteRule ^(config|src|migrations|bin|var)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]

    # If DocumentRoot points to package root instead of public/,
    # rewrite transparently into public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallback protection if mod_rewrite is absent
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</IfModule>
